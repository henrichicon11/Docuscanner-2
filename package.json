{
  "name": "docuscanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DocuScanner - a full-featured, offline-first document scanner web app (PWA)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "cap:sync": "vite build && cap sync android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "fake-indexeddb": "^6.2.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "jspdf": "^4.2.1",
    "tesseract.js": "^7.0.0"
  }
}
